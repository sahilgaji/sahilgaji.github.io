---
import "@fontsource-variable/newsreader";
import "@fontsource-variable/geist-mono";
import "../styles/tokens.css";
import ScrollProgress from "../components/ScrollProgress.astro";

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const {
  title,
  description = "Sahil Gaji — Project Management & Digital Transformation",
  lang = "en",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Pre-launch: not indexable until the v1.0 Definition of Done is met. See RUNBOOK.md. -->
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Applies a saved theme choice before first paint, so there's no
      // flash of the OS-default theme when a visitor has overridden it.
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.setAttribute("data-theme", saved);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <ScrollProgress />
    <slot />
    <script>
      // Fade-and-rise on first reveal (Phase 5 spec, sitewide). One-time
      // only — never re-triggers on scroll-up. No-op under
      // prefers-reduced-motion, where [data-reveal] is already visible
      // by default (see the global stylesheet).
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-revealed");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
        );
        document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background-color: var(--color-paper);
    background-image: radial-gradient(circle, var(--color-line) 1px, transparent 1px);
    background-size: 26px 26px;
    color: var(--color-ink);
    font-family: var(--font-sans);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  @media print {
    body {
      background-image: none !important;
    }
  }
  a {
    color: var(--color-accent);
    text-underline-offset: 3px;
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.24s ease-out, transform 0.24s ease-out;
  }
  [data-reveal].is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
