---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const cases = [
  {
    href: "/work/career-operating-system/",
    title: "Apply to fewer jobs, better.",
    org: "Career Operating System",
    body: "This job search, run like a transformation project — the real pipeline, a living dashboard, and a retrospective.",
  },
  {
    href: "/work/bosch-pmo/",
    title: "Getting 150+ people to actually use a new system.",
    org: "Robert Bosch GmbH",
    body: "Configuring the tool was the easy fifth of the work. The other four-fifths was training, documentation, and adoption.",
  },
  {
    href: "/work/club-house/",
    title: "The business that kept running after I left.",
    org: "Club House",
    body: "A food-and-beverage startup, co-founded alongside a full-time job. An honest account, not a success story.",
  },
];
---

<Base title="Work · Sahil Gaji" description="Three case studies: a self-built job-search system, a Bosch internship, and a startup that outlived its founder's involvement.">
  <Header current="work" />
  <main>
    <h1>Work</h1>
    <p class="intro">
      Three case studies. Each follows the same shape: what happened, what I
      built, what I'd do differently.
    </p>

    <ul class="cases">
      {
        cases.map((c) => (
          <li data-reveal>
            <a href={c.href}>
              <span class="bar" aria-hidden="true" />
              <span class="content">
                <p class="org">{c.org}</p>
                <p class="title">{c.title}</p>
                <p class="body">{c.body}</p>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="note">
      Every future case study ships as its own <a href="/changelog/">changelog</a> entry, not all at once.
    </p>
  </main>
  <Footer lang="en" />
</Base>

<style>
  main {
    max-width: var(--measure-prose);
    margin: 0 auto;
    padding: var(--space-8) var(--space-3);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.1rem, 5vw, 2.9rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    font-weight: 400;
    margin: 0 0 var(--space-3);
  }
  .intro {
    font-size: 1.05rem;
    margin: 0 0 var(--space-6);
    max-width: 40rem;
  }
  .cases {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .cases li {
    border: 1px solid var(--color-line);
    border-radius: 6px;
    overflow: hidden;
    transition: box-shadow 0.2s ease-out, transform 0.2s ease-out;
  }
  .cases li:has(a:hover) {
    border-color: var(--color-accent);
    box-shadow: 0 8px 28px color-mix(in srgb, var(--color-accent) 16%, transparent);
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .cases li {
      transition: none;
    }
    .cases li:has(a:hover) {
      transform: none;
    }
  }
  .cases a {
    display: flex;
    align-items: stretch;
    text-decoration: none;
    color: var(--color-ink);
  }
  .bar {
    width: 3px;
    flex-shrink: 0;
    background: var(--color-accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.2s ease-out;
  }
  .content {
    display: block;
    padding: var(--space-3);
    transition: transform 0.2s ease-out;
  }
  .cases a:hover .bar {
    transform: scaleY(1);
  }
  .cases a:hover .content {
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .bar,
    .content {
      transition: none;
    }
  }
  .org {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    margin: 0 0 var(--space-1);
  }
  .title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    margin: 0 0 var(--space-1);
  }
  .body {
    font-size: 0.95rem;
    color: var(--color-ink-muted);
    margin: 0;
  }
  .note {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }
</style>
