---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const cases = [
  {
    id: "cos",
    org: "Career Operating System",
    title: "Apply to fewer jobs, better.",
    stages: ["SCREEN", "GENERATE", "REVIEW", "SHIP"],
    statement:
      "This job search, run like a transformation project — the real pipeline, a living dashboard, and a retrospective.",
    details: [
      "Designed during a self-directed upskilling period focused on Python, automation, and AI/LLM tooling.",
      "Turns the daily job search into a focused operating rhythm rather than a volume exercise.",
      "Built around one belief: instrument the work, then improve the actual bottleneck.",
    ],
    href: "/work/career-operating-system/",
  },
  {
    id: "bosch",
    org: "Robert Bosch GmbH",
    title: "Getting 150+ people to actually use a new system.",
    stages: ["CONFIGURE", "TRAIN", "ADOPT", "SUSTAIN"],
    statement:
      "Configuring the tool was the easy fifth of the work. The other four-fifths was training, documentation, and adoption.",
    details: [
      "Standardized Jira workflows and PMO reporting across three cross-functional projects.",
      "Trained 150+ managers and team leads to make the new working system stick.",
      "Migrated documentation to Confluence, cutting document retrieval time by roughly 30%.",
    ],
    href: "/work/bosch-pmo/",
  },
  {
    id: "club",
    org: "Club House",
    title: "The business that kept running after I left.",
    stages: ["BUILD", "OPERATE", "HANDOVER", "CONTINUE"],
    statement:
      "A food-and-beverage startup, co-founded alongside a full-time job. An honest account, not a success story.",
    details: [
      "Built VBA tools for invoicing and stock tracking while co-founding the venture part-time.",
      "Secured ₹600,000 in funding and handed ownership to the remaining partners after six months.",
      "The business kept operating — a real test of systems over heroic effort.",
    ],
    href: "/work/club-house/",
  },
];
---

<Base title="Work · Sahil Gaji" description="Three case studies: a self-built job-search system, a Bosch internship, and a startup that outlived its founder's involvement.">
  <Header current="work" />
  <main>
    <h1>Work</h1>
    <p class="intro">
      Three case studies. Each starts with the same practical question: can
      the work continue without the person who built it?
    </p>

    <div class="switcher" data-reveal>
      {cases.map((c, i) => <input type="radio" name="proj" id={`proj-${c.id}`} checked={i === 0} class="switch-input" />)}

      <div class="switcher-grid">
        <div class="switch-list" role="tablist" aria-label="Select a case study">
          {
            cases.map((c) => (
              <label for={`proj-${c.id}`} class={`switch-row row-${c.id}`}>
                <span class="row-org">{c.org}</span>
                <span class="row-title">{c.title}</span>
              </label>
            ))
          }
        </div>

        <div class="switch-panels">
          {
            cases.map((c) => (
              <article class={`panel panel-${c.id}`}>
                <p class="stage-strip" aria-hidden="true">
                  {c.stages.map((s, i) => (
                    <>
                      <span>{s}</span>
                      {i < c.stages.length - 1 && <i>→</i>}
                    </>
                  ))}
                </p>
                <p class="statement">{c.statement}</p>
                <ul class="detail-list">
                  {c.details.map((d) => <li>{d}</li>)}
                </ul>
                <a href={c.href} class="text-link">Read the full case study →</a>
              </article>
            ))
          }
        </div>
      </div>
    </div>

    <p class="note">
      Every future case study ships as its own <a href="/changelog/">changelog</a> entry, not all at once.
    </p>
  </main>
  <Footer lang="en" />
</Base>

<style>
  main {
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding: var(--space-8) var(--space-3);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.1rem, 5vw, 2.9rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    font-weight: var(--font-display-weight);
    margin: 0 0 var(--space-3);
  }
  .intro {
    font-size: 1.05rem;
    margin: 0 0 var(--space-6);
    max-width: 40rem;
  }

  /* Hidden native radios drive the whole switcher — zero JavaScript. */
  .switch-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .switcher-grid {
    display: grid;
    grid-template-columns: minmax(14rem, 20rem) 1fr;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    overflow: hidden;
  }
  @media (max-width: 42rem) {
    .switcher-grid {
      grid-template-columns: 1fr;
    }
  }

  .switch-list {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-line) 25%, transparent);
  }
  @media (max-width: 42rem) {
    .switch-list {
      flex-direction: row;
      overflow-x: auto;
      border-right: none;
      border-bottom: 1px solid var(--color-line);
    }
  }

  .switch-row {
    display: block;
    padding: var(--space-3);
    cursor: pointer;
    border-left: 3px solid transparent;
    border-bottom: 1px solid var(--color-line);
    transition: border-color 0.15s ease-out, background 0.15s ease-out;
  }
  .switch-list label:last-child {
    border-bottom: none;
  }
  .switch-row:hover {
    border-left-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
  }
  .row-org {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
    margin-bottom: 0.2rem;
  }
  .row-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .switch-panels {
    position: relative;
    padding: var(--space-4);
  }
  .panel {
    display: none;
  }
  .stage-strip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    color: var(--color-accent);
    margin: 0 0 var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }
  .stage-strip i {
    font-style: normal;
    color: var(--color-ink-muted);
    opacity: 0.6;
  }
  .statement {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.35;
    margin: 0 0 var(--space-3);
    max-width: 34rem;
  }
  .detail-list {
    padding-left: 1.1rem;
    margin: 0 0 var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .detail-list li {
    font-size: 0.95rem;
    color: var(--color-ink-muted);
  }
  .text-link {
    font-size: 0.92rem;
  }

  /* Wire each radio to its row + panel via :has() — same technique already
     used for hover states elsewhere on this site (see Work cards). */
  #proj-cos:checked ~ .switcher-grid .row-cos,
  #proj-bosch:checked ~ .switcher-grid .row-bosch,
  #proj-club:checked ~ .switcher-grid .row-club {
    background: var(--color-paper);
    border-left-color: var(--color-accent);
  }
  #proj-cos:checked ~ .switcher-grid .panel-cos,
  #proj-bosch:checked ~ .switcher-grid .panel-bosch,
  #proj-club:checked ~ .switcher-grid .panel-club {
    display: block;
  }

  .note {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    margin-top: var(--space-6);
  }
</style>
