---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import LangToggle from "../components/LangToggle.astro";
import Nav from "../components/Nav.astro";
import Disclosure from "../components/Disclosure.astro";
import WipBadge from "../components/WipBadge.astro";
import changelog from "../data/changelog.json";

const latest = changelog[0];
const recent = changelog.slice(0, 3);
---

<Base title="Sahil Gaji">
  <main>
    <div class="aurora" aria-hidden="true"></div>
    <div class="topbar">
      <Nav />
      <div class="topbar-right">
        <a class="cv-link" href="/cv/">CV</a>
        <LangToggle lang="en" enHref="/" deHref="/de/" />
        <ThemeToggle />
      </div>
    </div>

    <WipBadge label="Work in progress" linkLabel="What's shipped so far" />

    <h1>Sahil Gaji</h1>
    <p class="tagline">I build systems that keep working when I leave the room.</p>

    <p class="evidence" data-reveal>
      At Bosch, I set up Jira workflows and a PMO reporting system, trained
      150+ managers and team leads — the systems stayed in use after my
      internship ended. I co-founded a food business that kept running after
      I handed it over. My own job search runs on a system I built — it
      takes about ten minutes of my attention a day.
    </p>

    <div class="human" data-reveal>
      <img src="/favicon.svg" alt="" class="avatar" width="56" height="56" />
      <p>
        <strong>The short version:</strong> mechanical engineer by training,
        project-management-and-digital-transformation person by choice. I
        moved to Germany in 2022 for a Master's degree, and these days I do
        part-time quality control at a Hamburg fulfilment center to stay
        afloat while I look for a junior PM, PMO, process, or
        digital-transformation role — which is also, not coincidentally,
        exactly what I'm legally authorized and available to start. German
        is B1 and improving; English carries the rest; Hindi and Marathi
        came first.
        <a href="/about/">The long version is here.</a>
      </p>
    </div>

    <p class="proof" data-reveal>
      M.Sc. Digital Transformation Management, SRH Berlin ("very good") ·
      Robert Bosch GmbH · the Career Operating System
    </p>

    <p class="contact">
      <a href="https://www.linkedin.com/in/sahil-gaji/">LinkedIn</a>
      ·
      <a href="mailto:sahil.gaji@outlook.com">sahil.gaji@outlook.com</a>
    </p>

    <Disclosure label="What's changed recently">
      <ul class="recent">
        {
          recent.map((entry) => (
            <li>
              <span class="v">v{entry.version}</span> — {entry.title}
              <span class="d">{entry.notes}</span>
            </li>
          ))
        }
      </ul>
      <p class="see-all"><a href="/changelog/">Full changelog →</a></p>
    </Disclosure>
  </main>

  <Footer lang="en" />
</Base>

<style>
  main {
    position: relative;
    max-width: var(--measure-prose);
    margin: 0 auto;
    padding: var(--space-12) var(--space-3) var(--space-8);
  }
  .aurora {
    position: absolute;
    top: -15%;
    left: -20%;
    right: -20%;
    height: 620px;
    background:
      radial-gradient(circle at 22% 28%, color-mix(in srgb, var(--color-accent) 22%, transparent), transparent 60%),
      radial-gradient(circle at 78% 15%, color-mix(in srgb, var(--color-accent) 14%, transparent), transparent 55%),
      radial-gradient(circle at 55% 55%, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 60%);
    filter: blur(60px);
    z-index: -1;
    pointer-events: none;
    animation: aurora-drift 26s ease-in-out infinite alternate;
  }
  @keyframes aurora-drift {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-4%, 3%) scale(1.06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .aurora {
      animation: none;
    }
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .topbar-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .cv-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.25rem 0.6rem;
  }
  .cv-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-1);
  }
  .tagline {
    font-family: var(--font-serif);
    font-size: clamp(2.1rem, 5.5vw, 3.4rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin: 0 0 var(--space-5);
  }
  .evidence {
    font-size: 1.05rem;
    max-width: 42rem;
    margin: 0 0 var(--space-6);
  }

  .human {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    margin-bottom: var(--space-6);
  }
  .avatar {
    border-radius: 50%;
    border: 1px solid var(--color-line);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
  .human p {
    margin: 0;
    font-size: 1rem;
    max-width: 42rem;
  }
  .human a {
    white-space: nowrap;
  }

  .proof {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-4);
  }
  .contact {
    font-size: 0.95rem;
    margin: 0 0 var(--space-6);
  }

  .recent {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .recent li {
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .recent .v {
    color: var(--color-accent);
  }
  .recent .d {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    margin-top: 0.15rem;
  }
  .see-all {
    margin: 0;
    font-size: 0.82rem;
  }
</style>
