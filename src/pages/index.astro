---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import LangToggle from "../components/LangToggle.astro";
import Nav from "../components/Nav.astro";
import changelog from "../data/changelog.json";

const latest = changelog[0];
---

<Base title="Sahil Gaji">
  <main>
    <div class="topbar">
      <Nav />
      <div class="topbar-right">
        <LangToggle lang="en" enHref="/" deHref="/de/" />
        <ThemeToggle />
      </div>
    </div>

    <h1>Sahil Gaji</h1>
    <p class="tagline">I build systems that keep working when I leave the room.</p>

    <p class="evidence">
      At Bosch, I set up Jira workflows and a PMO reporting system, trained
      150+ managers and team leads — the systems stayed in use after my
      internship ended. I co-founded a food business that kept running after
      I handed it over. My own job search runs on a system I built — it
      takes about ten minutes of my attention a day.
    </p>

    <div class="status-card">
      <img src="/favicon.svg" alt="" class="avatar" width="56" height="56" />
      <dl>
        <div>
          <dt>Currently</dt>
          <dd>
            Open to junior Project Management, PMO, Process Improvement, and
            Digital Transformation opportunities in Germany.
          </dd>
        </div>
        <div>
          <dt>Work authorization</dt>
          <dd>Legally authorized to work in Germany.</dd>
        </div>
        <div>
          <dt>Languages</dt>
          <dd>English (business fluent) · German (B1, in classes) · Hindi, Marathi (native)</dd>
        </div>
      </dl>
    </div>

    <p class="proof">
      M.Sc. Digital Transformation Management, SRH Berlin ("very good") ·
      Robert Bosch GmbH · the Career Operating System
    </p>

    <p class="contact">
      <a href="https://www.linkedin.com/in/sahil-gaji/">LinkedIn</a>
      ·
      <a href="mailto:sahil.gaji@outlook.com">sahil.gaji@outlook.com</a>
    </p>

    <div class="log" aria-label="Site status">
      <p class="entry">
        <span class="version">v{latest.version}</span> — {latest.title} ·
        <a href="/changelog/">changelog</a>
      </p>
    </div>
  </main>

  <Footer lang="en" />
</Base>

<style>
  main {
    max-width: var(--measure-prose);
    margin: 0 auto;
    padding: var(--space-12) var(--space-3) var(--space-8);
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .topbar-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-1);
  }
  .tagline {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    line-height: 1.25;
    text-wrap: balance;
    margin: 0 0 var(--space-4);
  }
  .evidence {
    font-size: 1.05rem;
    max-width: 42rem;
    margin: 0 0 var(--space-8);
  }

  .status-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .avatar {
    border-radius: 50%;
    border: 1px solid var(--color-line);
    flex-shrink: 0;
  }
  .status-card dl {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .status-card dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    margin: 0 0 0.2rem;
  }
  .status-card dd {
    margin: 0;
    font-size: 0.95rem;
  }

  .proof {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-4);
  }
  .contact {
    font-size: 0.95rem;
    margin: 0 0 var(--space-8);
  }

  .log {
    border-left: 2px solid var(--color-line);
    padding-left: var(--space-3);
  }
  .entry {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-ink-muted);
    margin: 0;
  }
  .version {
    color: var(--color-accent);
  }
</style>
