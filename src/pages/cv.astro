---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const experience = [
  {
    dates: "Oct 2025 – present",
    title: "Quality Control Associate (part-time)",
    org: "Picnic Technologies GmbH · Hamburg",
    bullets: [
      "Structured quality audits, inventory accuracy, and defect-pattern tracking at a fulfilment center.",
    ],
  },
  {
    dates: "Aug 2024 – Oct 2025",
    title: "Career Break — Self-Directed Upskilling",
    org: "",
    bullets: [
      "Learned Python, automation, and AI/LLM tooling.",
      "Designed and built an end-to-end job-search automation pipeline (see Projects).",
    ],
  },
  {
    dates: "Mar – Aug 2024",
    title: "Intern, Project Management Digitalization",
    org: "Robert Bosch GmbH · Reutlingen",
    bullets: [
      "Standardized Jira workflows and a PMO reporting system across 3 cross-functional projects.",
      "Trained 150+ managers and team leads on new tools and workflows.",
      "Migrated project documentation to Confluence, cutting retrieval time by roughly 30%.",
    ],
  },
  {
    dates: "Jan – Aug 2023",
    title: "Intern, Project Development & Finance Advisory",
    org: "Dornier Suntrace GmbH · Hamburg",
    bullets: [
      "Conducted market research for renewable-energy feasibility studies across Indonesia, Saudi Arabia, and Oman.",
      "Automated financial forecasting with Excel VBA, saving roughly 5 person-days a month.",
    ],
  },
  {
    dates: "Oct 2020 – Feb 2022",
    title: "Junior Market Correspondent",
    org: "GirnarSoft (ZigWheels) · Jaipur",
    bullets: [
      "Automotive market research and published product reviews.",
      "Grew site traffic roughly 20–24% through SEO and content strategy.",
    ],
  },
  {
    dates: "Jul – Dec 2020",
    title: "Co-Founder (part-time side venture)",
    org: "Club House · Pune",
    bullets: [
      "Co-founded a food-and-beverage startup alongside a full-time job.",
      "Built VBA tools for invoicing and stock tracking; secured ₹600,000 in funding.",
      "Handed ownership to remaining partners after six months — the business continued operating.",
    ],
  },
  {
    dates: "Nov 2019 – Oct 2020",
    title: "Quality Assurance Engineer",
    org: "KEIHIN FIE · Chakan",
    bullets: [
      "Quality control across die casting, machining, and assembly.",
      "Built a Power BI reporting system that cut defects roughly 15–16% and machine cycle time roughly 20%.",
    ],
  },
];

const education = [
  {
    dates: "Apr 2022 – Sep 2024",
    title: "M.Sc. Digital Transformation Management: Business Analytics",
    org: "SRH Berlin University of Applied Sciences",
    note: "Grade: 2.0, \"very good\" (German scale, 1.0 best)",
  },
  {
    dates: "Jun 2015 – May 2019",
    title: "B.Eng, Mechanical Engineering",
    org: "Savitribai Phule Pune University",
    note: "Grade: 2.4, \"Higher Second Class\"",
  },
];

const certifications = [
  "Google Project Management Professional Certificate",
  "Business Analysis Foundations — LinkedIn Learning",
  "Lean Six Sigma Yellow Belt — Udemy",
  "Introduction to Power BI — DataCamp",
  "Introduction to Python — DataCamp",
  "Google Data Analytics Certificate",
];

const skills = [
  { label: "Project & process", value: "Project coordination, process documentation, BPMN process mapping, Agile/Scrum exposure" },
  { label: "Tools", value: "Jira, Confluence, Power BI, Excel/VBA, Power Automate, Python" },
  { label: "Analysis", value: "Market research, financial forecasting, KPI reporting, root-cause analysis" },
];
---

<Base title="CV · Sahil Gaji" description="Sahil Gaji's CV — Project Management & Digital Transformation.">
  <Header />
  <main>
    <div class="actions no-print">
      <button id="print-btn" type="button">Print / Save as PDF</button>
      <a href="/about/">← Back to About</a>
    </div>

    <header class="cv-header">
      <h1>Sahil Gaji</h1>
      <p class="role">Project Management · Digital Transformation</p>
      <p class="contact">
        Hamburg, Germany ·
        <a href="mailto:sahil.gaji@outlook.com">sahil.gaji@outlook.com</a> ·
        <a href="https://www.linkedin.com/in/sahil-gaji/">linkedin.com/in/sahil-gaji</a> ·
        <a href="https://github.com/sahilgaji">github.com/sahilgaji</a>
      </p>
      <p class="meta">
        Legally authorized to work in Germany. English (business fluent) ·
        German (B1, in classes) · Hindi, Marathi (native)
      </p>
    </header>

    <section class="summary">
      <p>
        Junior Project Management / Digital Transformation professional with
        an M.Sc. in Digital Transformation Management and hands-on
        experience across PMO digitalization (Bosch), renewable-energy
        project finance (Dornier Suntrace), and quality/operations (KEIHIN,
        Picnic Technologies). Builds and ships process automation
        end-to-end — most recently a full job-search automation pipeline
        (sahilgaji.github.io/work/career-operating-system).
      </p>
    </section>

    <section>
      <h2>Experience</h2>
      {
        experience.map((role) => (
          <article class="entry">
            <div class="entry-head">
              <p class="entry-title">{role.title}</p>
              <p class="entry-dates">{role.dates}</p>
            </div>
            {role.org && <p class="entry-org">{role.org}</p>}
            <ul>
              {role.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </article>
        ))
      }
    </section>

    <section>
      <h2>Education</h2>
      {
        education.map((ed) => (
          <article class="entry">
            <div class="entry-head">
              <p class="entry-title">{ed.title}</p>
              <p class="entry-dates">{ed.dates}</p>
            </div>
            <p class="entry-org">{ed.org}</p>
            <p class="entry-note">{ed.note}</p>
          </article>
        ))
      }
    </section>

    <section>
      <h2>Certifications</h2>
      <ul class="flat-list">
        {certifications.map((c) => <li>{c}</li>)}
      </ul>
    </section>

    <section>
      <h2>Skills</h2>
      <ul class="skills">
        {
          skills.map((s) => (
            <li><strong>{s.label}:</strong> {s.value}</li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer lang="en" />
</Base>

<script>
  document.getElementById("print-btn")?.addEventListener("click", () => {
    window.print();
  });
</script>

<style>
  main {
    max-width: 42rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-3) var(--space-8);
  }
  .actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    font-size: 0.85rem;
  }
  .actions button {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background: none;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.5rem 0.9rem;
    color: var(--color-ink);
    cursor: pointer;
  }
  .actions button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .actions a {
    color: var(--color-ink-muted);
  }

  .cv-header {
    margin-bottom: var(--space-5);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: 1.9rem;
    font-weight: var(--font-display-weight);
    margin: 0;
  }
  .role {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-accent);
    margin: 0.2rem 0 0.5rem;
  }
  .contact {
    font-size: 0.88rem;
    margin: 0 0 0.3rem;
  }
  .meta {
    font-size: 0.82rem;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .summary {
    margin-bottom: var(--space-6);
    font-size: 0.95rem;
    border-left: 2px solid var(--color-line);
    padding-left: var(--space-3);
  }
  .summary p {
    margin: 0;
  }

  section {
    margin-bottom: var(--space-6);
  }
  h2 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.3rem;
    margin: 0 0 var(--space-3);
  }

  .entry {
    margin-bottom: var(--space-3);
    break-inside: avoid;
  }
  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .entry-title {
    font-weight: 600;
    margin: 0;
  }
  .entry-dates {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-ink-muted);
    margin: 0;
    white-space: nowrap;
  }
  .entry-org {
    color: var(--color-ink-muted);
    font-size: 0.88rem;
    margin: 0.1rem 0 0.3rem;
  }
  .entry-note {
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    margin: 0;
  }
  .entry ul {
    margin: 0.3rem 0 0;
    padding-left: 1.1rem;
  }
  .entry li {
    font-size: 0.92rem;
    margin-bottom: 0.2rem;
  }

  .flat-list,
  .skills {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
  }

  @media print {
    :global(header),
    :global(footer),
    .no-print {
      display: none !important;
    }
    :global(body) {
      background: #fff !important;
      color: #111 !important;
    }
    main {
      max-width: 100%;
      padding: 0;
    }
    .role,
    h2 {
      color: #444 !important;
    }
    a {
      color: #111 !important;
      text-decoration: none !important;
    }
  }
</style>
