---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Disclosure from "../components/Disclosure.astro";

const principles = [
  {
    title: "Understand before solving",
    quote: "They come because I'm patient enough to understand the problem before trying to solve it.",
    body: "People bring me a disorganized spreadsheet, a confusing workflow, or an unclear plan — not because I always have the answer, but because I ask questions first and break the problem into parts before touching a solution.",
  },
  {
    title: "Systems over heroics",
    quote: "If a process only works because one person is always present, I don't think it's a very good process.",
    body: "I co-founded Club House, a food-and-beverage startup, alongside a full-time job. When I handed it over after six months, it kept running — because the billing, inventory, and ordering processes didn't depend on me being in the room.",
  },
  {
    title: "Honesty is a strategy, not a risk",
    quote: null,
    body: "My German is B1, and I say so everywhere on this site rather than let a fluent-reading page set an expectation an interview can't meet. The period between my Master's and my current work is labeled \"career break\" here, not hidden or renamed — because that's what it was, and because it's where I built the system this site's flagship case study is about.",
    aside: "B1 is enough to order coffee, survive a Bürgeramt appointment, and read this page's own Impressum slowly. Job interviews are next on the list.",
  },
  {
    title: "Measure before improving",
    quote: null,
    body: "At KEIHIN, I built a Power BI reporting system that helped cut defects by roughly 15% and machine cycle time by roughly 20%. Years later I did the same thing to my own job search — instrument it, watch what the numbers say, then change the process instead of just working harder at it.",
  },
  {
    title: "Adoption is the product",
    quote: null,
    body: "At Bosch, configuring Jira for three cross-functional projects was the easy part. Training 150+ managers and team leads to actually use it — that was the project. Most \"failed\" digital transformations aren't technology failures; they're adoption failures wearing a technology costume.",
  },
];

const mindChanges = [
  "I used to think the job search was a numbers game — send more applications, get more interviews. Now I think fewer, better-targeted applications outperform volume, and I built a system around that belief.",
  "I used to think working hard would naturally make opportunities appear. It took months of quiet rejection to learn that effort pointed at the wrong bottleneck doesn't compound — it just accumulates.",
];
---

<Base title="How I work · Sahil Gaji" description="Five operating principles, each with the story and evidence behind it.">
  <Header current="how-i-work" />
  <main>
    <h1>How I work</h1>
    <p class="intro">
      Five things I keep coming back to — each with the story and the
      evidence behind it, not just the claim.
    </p>

    <ol class="principles">
      {
        principles.map((p) => (
          <li data-reveal>
            <h2>{p.title}</h2>
            {p.quote && <blockquote>{p.quote}</blockquote>}
            <p>{p.body}</p>
            {p.aside && (
              <Disclosure label="the honest bit">
                <p class="aside">{p.aside}</p>
              </Disclosure>
            )}
          </li>
        ))
      }
    </ol>

    <section>
      <h2 class="section-head">Things I've changed my mind about</h2>
      <ul class="mind-changes">
        {mindChanges.map((m) => <li>{m}</li>)}
      </ul>
    </section>
  </main>
  <Footer lang="en" />
</Base>

<style>
  main {
    max-width: var(--measure-prose);
    margin: 0 auto;
    padding: var(--space-8) var(--space-3);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 400;
    margin: 0 0 var(--space-3);
  }
  .intro {
    max-width: 42rem;
    font-size: 1.05rem;
    margin: 0 0 var(--space-8);
  }

  .principles {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-8);
    counter-reset: principle;
  }
  .principles li {
    counter-increment: principle;
    border-left: 2px solid var(--color-line);
    padding-left: var(--space-3);
    padding-bottom: var(--space-6);
    position: relative;
    transition: border-color 0.15s ease-out, padding-left 0.15s ease-out;
  }
  .principles li:last-child {
    padding-bottom: 0;
  }
  .principles li:hover {
    border-left-color: var(--color-accent);
    padding-left: calc(var(--space-3) + 4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .principles li {
      transition: none;
    }
  }
  .principles li::before {
    content: counter(principle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.25rem;
  }
  .principles h2 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 400;
    margin: 0 0 var(--space-2);
  }
  .principles blockquote {
    margin: 0 0 var(--space-2);
    padding-left: var(--space-2);
    border-left: 2px solid var(--color-accent);
    font-style: italic;
    color: var(--color-ink-muted);
  }
  .principles p {
    margin: 0;
    font-size: 0.98rem;
  }
  .principles li :global(.disclosure) {
    margin-top: var(--space-2);
    border-left-color: var(--color-line);
  }
  .aside {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-ink-muted);
    font-style: italic;
  }

  .section-head {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 400;
    margin: 0 0 var(--space-3);
  }
  .mind-changes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .mind-changes li {
    border-left: 2px solid var(--color-line);
    padding-left: var(--space-3);
    font-size: 0.98rem;
  }
</style>
