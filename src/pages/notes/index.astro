---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Base title="Notes · Sahil Gaji" description="Articles, in progress.">
  <Header current="notes" />
  <main>
    <h1>Notes</h1>
    <p class="intro">
      Nothing's published here yet. First up:
    </p>
    <ul class="queue">
      <li><strong>"The month I stopped applying harder and started applying better"</strong> — the mistake that led to the Career Operating System.</li>
      <li><strong>"Nobody adopts your tool because it's good"</strong> — what Bosch taught me about digital transformation being a people problem.</li>
      <li>A third, on what a food business taught me about processes.</li>
    </ul>
    <p class="note">
      One article every 1–2 months, honestly. Follow the
      <a href="/changelog/">changelog</a> to see the first one land.
    </p>
  </main>
  <Footer lang="en" />
</Base>

<style>
  main {
    max-width: var(--measure-prose);
    margin: 0 auto;
    padding: var(--space-8) var(--space-3);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 400;
    margin: 0 0 var(--space-3);
  }
  .intro {
    font-size: 1.05rem;
    margin: 0 0 var(--space-3);
  }
  .queue {
    padding-left: 1.2rem;
    margin: 0 0 var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .queue li {
    font-size: 0.98rem;
  }
  .note {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }
</style>
