---
import Base from "../../layouts/Base.astro";
import Footer from "../../components/Footer.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import LangToggle from "../../components/LangToggle.astro";
import changelog from "../../data/changelog.json";

const latest = changelog[0];
---

<Base
  title="Sahil Gaji"
  description="Sahil Gaji — Projektmanagement & Digitale Transformation"
  lang="de"
>
  <main>
    <div class="topbar">
      <LangToggle lang="de" enHref="/" deHref="/de/" />
      <ThemeToggle />
    </div>
    <h1>Sahil Gaji</h1>
    <p class="role">Projektmanagement · Digitale Transformation · Deutschland</p>

    <div class="log" aria-label="Website-Status">
      <p class="entry">
        <span class="version">v{latest.version}</span> — {latest.title}
      </p>
      <p>
        Diese Website entsteht öffentlich. Sie geht live, sobald sie ihre
        eigenen Kriterien erfüllt — nicht an einem festen Datum.
      </p>
    </div>

    <p class="note">
      Deutsche Übersetzung: KI-unterstützt erstellt, inhaltlich von mir
      geprüft.
    </p>

    <p class="links">
      <a href="https://www.linkedin.com/in/sahil-gaji/">LinkedIn</a>
    </p>
  </main>

  <Footer lang="de" />
</Base>

<style>
  main {
    max-width: var(--measure-prose);
    margin: 0 auto;
    padding: var(--space-12) var(--space-3) var(--space-8);
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 400;
    margin: 0;
  }
  .role {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    margin: var(--space-1) 0 var(--space-8);
  }
  .log {
    border-left: 2px solid var(--color-line);
    padding-left: var(--space-3);
    font-size: 0.95rem;
  }
  .entry {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .version {
    color: var(--color-accent);
  }
  .note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
    margin-top: var(--space-3);
  }
  .links {
    margin-top: var(--space-8);
  }
</style>
