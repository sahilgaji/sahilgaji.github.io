---
import Base from "../../layouts/Base.astro";
import Footer from "../../components/Footer.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import LangToggle from "../../components/LangToggle.astro";
import Nav from "../../components/Nav.astro";
import WipBadge from "../../components/WipBadge.astro";
import changelog from "../../data/changelog.json";

const latest = changelog[0];

const modules = [
  {
    num: "01",
    href: "/work/",
    title: "Work",
    body: "Drei Fallstudien — ein selbst gebautes Automatisierungssystem, ein Bosch-Praktikum, ein Startup, das seinen Gründer überdauert hat.",
  },
  {
    num: "02",
    href: "/how-i-work/",
    title: "How I work",
    body: "Fünf Dinge, auf die ich immer wieder zurückkomme — jeweils mit Beleg.",
  },
  {
    num: "03",
    href: "/about/",
    title: "About",
    body: "Sechs Stationen, zwei Abschlüsse, ein Muster.",
  },
  {
    num: "04",
    href: "/cv/",
    title: "CV",
    body: "Aktuelle Version ansehen oder drucken.",
  },
  {
    num: "05",
    href: "/notes/",
    title: "Notes",
    body: "Artikel, in Vorbereitung.",
  },
];
---

<Base
  title="Sahil Gaji"
  description="Sahil Gaji — Projektmanagement & Digitale Transformation"
  lang="de"
>
  <main>
    <div class="aurora" aria-hidden="true"></div>
    <div class="topbar">
      <Nav />
      <div class="topbar-right">
        <a class="cv-link" href="/cv/">CV</a>
        <LangToggle lang="de" enHref="/" deHref="/de/" />
        <ThemeToggle />
      </div>
    </div>

    <WipBadge label="Im Aufbau" linkLabel="Was bisher fertig ist" />

    <h1>Sahil Gaji</h1>
    <p class="tagline">Ich baue Systeme, die auch ohne mich weiterlaufen.</p>

    <p class="evidence" data-reveal>
      Bei Bosch habe ich Jira-Workflows und ein PMO-Reporting-System
      aufgebaut und 150+ Führungskräfte und Teamleiter geschult — die
      Systeme wurden auch nach meinem Praktikum weiter genutzt. Ich habe ein
      Food-Startup mitgegründet, das nach meinem Ausstieg weiterlief. Meine
      eigene Jobsuche läuft über ein System, das ich selbst gebaut habe — es
      braucht etwa zehn Minuten meiner Aufmerksamkeit pro Tag.
    </p>

    <div class="human" data-reveal>
      <img src="/favicon.svg" alt="" class="avatar" width="56" height="56" />
      <p>
        <strong>Kurz gesagt:</strong> Maschinenbauingenieur von Ausbildung
        her, Projektmanagement- und Digital-Transformation-Mensch aus
        Überzeugung. 2022 bin ich für einen Master nach Deutschland gezogen,
        und aktuell arbeite ich Teilzeit in der Qualitätskontrolle in einem
        Fulfilment-Center in Hamburg, um über die Runden zu kommen, während
        ich eine Junior-Stelle in Projektmanagement, PMO, Prozessverbesserung
        oder Digitaler Transformation suche — genau das, wofür ich auch
        legal arbeitsberechtigt und verfügbar bin, nicht zufällig. Deutsch
        ist B1 und wird besser; Englisch trägt den Rest; Hindi und Marathi
        kamen zuerst.
        <a href="/about/">Die lange Version gibt es hier.</a>
      </p>
    </div>

    <p class="note">
      Deutsche Übersetzung: KI-unterstützt erstellt, inhaltlich von mir
      geprüft.
    </p>

    <p class="proof" data-reveal>
      M.Sc. Digital Transformation Management, SRH Berlin ("sehr gut") ·
      Robert Bosch GmbH · das Career Operating System
    </p>

    <ol class="modules">
      {
        modules.map((m) => (
          <li data-reveal>
            <a href={m.href}>
              <span class="bar" aria-hidden="true" />
              <span class="content">
                <p class="num">{m.num}</p>
                <p class="mod-title">{m.title}</p>
                <p class="mod-body">{m.body}</p>
              </span>
            </a>
          </li>
        ))
      }
      <li data-reveal class="wide">
        <a href="/changelog/">
          <span class="bar" aria-hidden="true" />
          <span class="content">
            <p class="num">06</p>
            <p class="mod-title">Wird gerade gebaut — v{latest.version}</p>
            <p class="mod-body">{latest.title}. {latest.notes}</p>
          </span>
        </a>
      </li>
    </ol>

    <p class="contact">
      <a href="https://www.linkedin.com/in/sahil-gaji/">LinkedIn</a>
      ·
      <a href="mailto:sahil.gaji@outlook.com">sahil.gaji@outlook.com</a>
    </p>
  </main>

  <Footer lang="de" />
</Base>

<style>
  main {
    position: relative;
    max-width: var(--measure-prose);
    margin: 0 auto;
    padding: var(--space-12) var(--space-3) var(--space-8);
  }
  .aurora {
    position: absolute;
    top: -15%;
    left: -20%;
    right: -20%;
    height: 620px;
    background:
      radial-gradient(circle at 22% 28%, color-mix(in srgb, var(--color-accent) 22%, transparent), transparent 60%),
      radial-gradient(circle at 78% 15%, color-mix(in srgb, var(--color-accent) 14%, transparent), transparent 55%),
      radial-gradient(circle at 55% 55%, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 60%);
    filter: blur(60px);
    z-index: -1;
    pointer-events: none;
    animation: aurora-drift 26s ease-in-out infinite alternate;
  }
  @keyframes aurora-drift {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-4%, 3%) scale(1.06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .aurora {
      animation: none;
    }
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .topbar-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .cv-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.25rem 0.6rem;
  }
  .cv-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: var(--font-display-weight);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-1);
  }
  .tagline {
    font-family: var(--font-serif);
    font-size: clamp(2.1rem, 5.5vw, 3.4rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin: 0 0 var(--space-5);
  }
  .evidence {
    font-size: 1.05rem;
    max-width: 42rem;
    margin: 0 0 var(--space-6);
  }

  .human {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    margin-bottom: var(--space-2);
  }
  .avatar {
    border-radius: 50%;
    border: 1px solid var(--color-line);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
  .human p {
    margin: 0;
    font-size: 1rem;
    max-width: 42rem;
  }
  .human a {
    white-space: nowrap;
  }
  .note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-6);
  }

  .proof {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-6);
  }

  .modules {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-2);
  }
  .modules li {
    border: 1px solid var(--color-line);
    border-radius: 6px;
    overflow: hidden;
    transition: box-shadow 0.2s ease-out, transform 0.2s ease-out, border-color 0.2s ease-out;
  }
  .modules li.wide {
    grid-column: 1 / -1;
  }
  .modules li:has(a:hover) {
    border-color: var(--color-accent);
    box-shadow: 0 8px 28px color-mix(in srgb, var(--color-accent) 16%, transparent);
    transform: translateY(-2px);
  }
  .modules a {
    display: flex;
    align-items: stretch;
    height: 100%;
    text-decoration: none;
    color: var(--color-ink);
  }
  .modules .bar {
    width: 3px;
    flex-shrink: 0;
    background: var(--color-accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.2s ease-out;
  }
  .modules a:hover .bar {
    transform: scaleY(1);
  }
  .modules .content {
    display: block;
    padding: var(--space-3);
    transition: transform 0.2s ease-out;
  }
  .modules a:hover .content {
    transform: translateX(4px);
  }
  .num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-accent);
    margin: 0 0 var(--space-1);
  }
  .mod-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    margin: 0 0 0.25rem;
  }
  .mod-body {
    font-size: 0.88rem;
    color: var(--color-ink-muted);
    margin: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .modules li,
    .modules .bar,
    .modules .content {
      transition: none;
    }
    .modules li:has(a:hover) {
      transform: none;
    }
  }

  .contact {
    font-size: 0.95rem;
    margin: 0;
  }
</style>
