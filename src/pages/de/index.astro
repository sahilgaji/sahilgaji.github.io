---
import Base from "../../layouts/Base.astro";
import Footer from "../../components/Footer.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import LangToggle from "../../components/LangToggle.astro";
import Nav from "../../components/Nav.astro";
import Disclosure from "../../components/Disclosure.astro";
import changelog from "../../data/changelog.json";

const latest = changelog[0];
const recent = changelog.slice(0, 3);
---

<Base
  title="Sahil Gaji"
  description="Sahil Gaji — Projektmanagement & Digitale Transformation"
  lang="de"
>
  <main>
    <div class="topbar">
      <Nav />
      <div class="topbar-right">
        <LangToggle lang="de" enHref="/" deHref="/de/" />
        <ThemeToggle />
      </div>
    </div>

    <h1>Sahil Gaji</h1>
    <p class="tagline">Ich baue Systeme, die auch ohne mich weiterlaufen.</p>

    <p class="evidence">
      Bei Bosch habe ich Jira-Workflows und ein PMO-Reporting-System
      aufgebaut und 150+ Führungskräfte und Teamleiter geschult — die
      Systeme wurden auch nach meinem Praktikum weiter genutzt. Ich habe ein
      Food-Startup mitgegründet, das nach meinem Ausstieg weiterlief. Meine
      eigene Jobsuche läuft über ein System, das ich selbst gebaut habe — es
      braucht etwa zehn Minuten meiner Aufmerksamkeit pro Tag.
    </p>

    <div class="human">
      <img src="/favicon.svg" alt="" class="avatar" width="56" height="56" />
      <p>
        <strong>Kurz gesagt:</strong> Maschinenbauingenieur von Ausbildung
        her, Projektmanagement- und Digital-Transformation-Mensch aus
        Überzeugung. 2022 bin ich für einen Master nach Deutschland gezogen,
        und aktuell arbeite ich Teilzeit in der Qualitätskontrolle in einem
        Fulfilment-Center in Hamburg, um über die Runden zu kommen, während
        ich eine Junior-Stelle in Projektmanagement, PMO, Prozessverbesserung
        oder Digitaler Transformation suche — genau das, wofür ich auch
        legal arbeitsberechtigt und verfügbar bin, nicht zufällig. Deutsch
        ist B1 und wird besser; Englisch trägt den Rest; Hindi und Marathi
        kamen zuerst.
        <a href="/about/">Die lange Version gibt es hier.</a>
      </p>
    </div>

    <p class="note">
      Deutsche Übersetzung: KI-unterstützt erstellt, inhaltlich von mir
      geprüft.
    </p>

    <p class="proof">
      M.Sc. Digital Transformation Management, SRH Berlin ("sehr gut") ·
      Robert Bosch GmbH · das Career Operating System
    </p>

    <p class="contact">
      <a href="https://www.linkedin.com/in/sahil-gaji/">LinkedIn</a>
      ·
      <a href="mailto:sahil.gaji@outlook.com">sahil.gaji@outlook.com</a>
    </p>

    <Disclosure label="Was sich zuletzt geändert hat">
      <ul class="recent">
        {
          recent.map((entry) => (
            <li>
              <span class="v">v{entry.version}</span> — {entry.title}
              <span class="d">{entry.notes}</span>
            </li>
          ))
        }
      </ul>
      <p class="see-all"><a href="/changelog/">Vollständiges Changelog →</a></p>
    </Disclosure>
  </main>

  <Footer lang="de" />
</Base>

<style>
  main {
    max-width: var(--measure-prose);
    margin: 0 auto;
    padding: var(--space-12) var(--space-3) var(--space-8);
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .topbar-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-1);
  }
  .tagline {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    line-height: 1.25;
    text-wrap: balance;
    margin: 0 0 var(--space-4);
  }
  .evidence {
    font-size: 1.05rem;
    max-width: 42rem;
    margin: 0 0 var(--space-6);
  }

  .human {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    margin-bottom: var(--space-2);
  }
  .avatar {
    border-radius: 50%;
    border: 1px solid var(--color-line);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
  .human p {
    margin: 0;
    font-size: 1rem;
    max-width: 42rem;
  }
  .human a {
    white-space: nowrap;
  }
  .note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-6);
  }

  .proof {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-4);
  }
  .contact {
    font-size: 0.95rem;
    margin: 0 0 var(--space-6);
  }

  .recent {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .recent li {
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .recent .v {
    color: var(--color-accent);
  }
  .recent .d {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    margin-top: 0.15rem;
  }
  .see-all {
    margin: 0;
    font-size: 0.82rem;
  }
</style>
