---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Disclosure from "../components/Disclosure.astro";

const timeline = [
  {
    dates: "Oct 2025 – present",
    title: "Quality Control Associate (part-time)",
    org: "Picnic Technologies GmbH, Hamburg",
    body: "Structured quality audits, inventory accuracy, and defect-pattern tracking at a fulfilment center — current, part-time, and complementary to the target track above rather than the destination.",
  },
  {
    dates: "Aug 2024 – Oct 2025",
    title: "Career break — self-directed upskilling",
    org: "",
    body: "Learned Python, automation, and AI/LLM tooling. Designed and built the Career Operating System — the job-search automation this site's flagship case study is about.",
  },
  {
    dates: "Mar – Aug 2024",
    title: "Intern, Project Management Digitalization",
    org: "Robert Bosch GmbH, Reutlingen",
    body: "Standardized Jira workflows and a PMO reporting system across 3 cross-functional projects, trained 150+ managers and team leads, and cut document retrieval time by roughly 30% migrating documentation to Confluence.",
    aside: "Configuring Jira was maybe a fifth of the actual work. The other four-fifths was convincing 150 people that yet another new tool was worth their time.",
    caseStudyHref: "/work/bosch-pmo/",
    caseStudyLabel: "Full case study",
  },
  {
    dates: "Apr 2022 – Sep 2024",
    title: "M.Sc. Digital Transformation Management: Business Analytics",
    org: "SRH Berlin University of Applied Sciences",
    body: "Grade: 2.0, \"very good\" (German scale, 1.0 best). Process management, digital business models, change management, digital leadership.",
  },
  {
    dates: "Jan – Aug 2023",
    title: "Intern, Project Development & Finance Advisory",
    org: "Dornier Suntrace GmbH, Hamburg",
    body: "Market research for renewable-energy feasibility studies across Indonesia, Saudi Arabia, and Oman. Automated financial forecasting with Excel VBA, saving roughly 5 person-days a month.",
  },
  {
    dates: "Oct 2020 – Feb 2022",
    title: "Junior Market Correspondent",
    org: "GirnarSoft (ZigWheels), Jaipur",
    body: "Automotive market research and published product reviews. Grew site traffic roughly 20–24% through SEO and content strategy.",
  },
  {
    dates: "Jul – Dec 2020",
    title: "Co-Founder (part-time side venture)",
    org: "Club House, Pune",
    body: "Co-founded a food-and-beverage startup alongside a full-time job. Built VBA tools for invoicing and stock tracking, secured ₹600,000 in funding. Handed ownership to the remaining partners after six months — the business kept running.",
    aside: "Which either means the systems I set up were good, or that I wasn't as essential as I liked to think. Possibly both.",
    caseStudyHref: "/work/club-house/",
    caseStudyLabel: "Full case study",
  },
  {
    dates: "Nov 2019 – Oct 2020",
    title: "Quality Assurance Engineer",
    org: "KEIHIN FIE, Chakan",
    body: "Quality control across die casting, machining, and assembly. Built a Power BI reporting system that cut defects roughly 15–16% and machine cycle time roughly 20%.",
  },
  {
    dates: "Jun 2015 – May 2019",
    title: "B.Eng, Mechanical Engineering",
    org: "Savitribai Phule Pune University",
    body: "Grade: 2.4, \"Higher Second Class.\" Manufacturing, systems engineering, Lean/Six Sigma, quality control.",
  },
];

const shelf = [
  {
    title: "Atomic Habits",
    author: "James Clear",
    note: "Long-term improvement usually comes from designing better systems rather than relying on motivation.",
  },
  {
    title: "The Goal",
    author: "Eliyahu M. Goldratt",
    note: "Changed how I think about bottlenecks: improving everything equally rarely improves the whole system.",
  },
  {
    title: "The Phoenix Project",
    author: "Gene Kim, Kevin Behr & George Spafford",
    note: "Technology, operations, communication, and business outcomes are connected through the flow of work.",
  },
  {
    title: "Thinking, Fast and Slow",
    author: "Daniel Kahneman",
    note: "Made me more aware of cognitive biases and the importance of slowing down important decisions.",
  },
  {
    title: "The Lean Startup",
    author: "Eric Ries",
    note: "Test assumptions early instead of investing heavily before validating.",
  },
];
---

<Base title="About · Sahil Gaji" description="Sahil Gaji's background — the systems thread across six roles and two degrees.">
  <Header current="about" />
  <main>
    <h1>About</h1>
    <p class="intro">
      Six roles, four industries, two countries — and the same behavior every
      time: find the messy process, make it legible, build something that
      keeps running without me. Mechanical systems first, then production
      systems, a business I helped start, energy-project systems, digital
      systems at Bosch, and now a system I built for my own job search.
    </p>

    <section aria-label="Timeline">
      <ol class="timeline">
        {
          timeline.map((item) => (
            <li>
              <p class="dates">{item.dates}</p>
              <p class="role-title">{item.title}</p>
              {item.org && <p class="org">{item.org}</p>}
              <p class="body">{item.body}</p>
              {item.caseStudyHref && (
                <p class="case-link"><a href={item.caseStudyHref}>{item.caseStudyLabel} →</a></p>
              )}
              {item.aside && (
                <Disclosure label="the honest bit">
                  <p class="aside">{item.aside}</p>
                </Disclosure>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section>
      <h2>Languages</h2>
      <p>English (business fluent) · German (B1, in classes) · Hindi, Marathi (native)</p>
    </section>

    <section>
      <h2>On the shelf</h2>
      <p class="shelf-intro">Books that genuinely changed how I think, not ones I feel obliged to list.</p>
      <ul class="shelf">
        {
          shelf.map((book) => (
            <li>
              <p class="book-title">{book.title} <span class="author">— {book.author}</span></p>
              <p class="note">{book.note}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2>Outside work</h2>
      <p>
        Cycling, walking, and swimming. Music. Strategy games. Digital
        sketching — including the diagrams on this site.
      </p>
    </section>

    <section>
      <h2>Contact</h2>
      <p class="contact">
        <a href="https://www.linkedin.com/in/sahil-gaji/">LinkedIn</a>
        ·
        <a href="mailto:sahil.gaji@outlook.com">sahil.gaji@outlook.com</a>
        ·
        <a href="https://github.com/sahilgaji/sahilgaji.github.io">GitHub</a>
      </p>
      <p class="cv-note">CV download — coming shortly.</p>
    </section>
  </main>
  <Footer lang="en" />
</Base>

<style>
  main {
    max-width: var(--measure-prose);
    margin: 0 auto;
    padding: var(--space-8) var(--space-3);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 400;
    margin: 0 0 var(--space-3);
  }
  .intro {
    max-width: 42rem;
    font-size: 1.05rem;
    margin: 0 0 var(--space-8);
  }

  h2 {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 400;
    margin: 0 0 var(--space-3);
  }
  section {
    margin-bottom: var(--space-8);
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .timeline li {
    border-left: 2px solid var(--color-line);
    padding-left: var(--space-3);
    padding-bottom: var(--space-6);
  }
  .timeline li:last-child {
    padding-bottom: 0;
  }
  .dates {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-accent);
    margin: 0 0 0.2rem;
  }
  .role-title {
    font-weight: 600;
    margin: 0;
  }
  .org {
    color: var(--color-ink-muted);
    font-size: 0.92rem;
    margin: 0.1rem 0 0.4rem;
  }
  .timeline .body {
    margin: 0;
    font-size: 0.95rem;
  }
  .case-link {
    margin: 0.3rem 0 0;
    font-size: 0.85rem;
  }
  .timeline li :global(.disclosure) {
    margin-top: var(--space-2);
    border-left-color: var(--color-line);
  }
  .aside {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-ink-muted);
    font-style: italic;
  }

  .shelf-intro {
    color: var(--color-ink-muted);
    font-size: 0.92rem;
    margin: 0 0 var(--space-3);
  }
  .shelf {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .book-title {
    margin: 0;
    font-weight: 600;
  }
  .author {
    font-weight: 400;
    color: var(--color-ink-muted);
  }
  .shelf .note {
    margin: 0.15rem 0 0;
    font-size: 0.92rem;
    color: var(--color-ink-muted);
  }

  .contact {
    margin: 0 0 var(--space-1);
  }
  .cv-note {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-ink-muted);
    margin: 0;
  }
</style>
