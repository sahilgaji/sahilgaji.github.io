---
// Career Operating System architecture diagram — accurate to the real
// pipeline (screen_job.py, auto_apply.py, generate_application.py,
// ats_score.py, the tracker, review_outcomes.py). Digital version for now;
// replaced by a hand-drawn one per the Phase 10 fallback plan (see the repo
// changelog and RUNBOOK for the pending swap).
---

<figure class="cos-diagram">
  <div class="wrap">
    <svg viewBox="0 0 980 1720" role="img" aria-label="Flowchart of the Career Operating System: postings are scraped, passed through auto-reject gates, scored by persona, checked for confidence, used to generate a tailored CV and cover letter with keyword-traceability guardrails, checked against a 75 percent ATS threshold, reviewed by a human, sent with outreach, logged in a tracker, and reviewed monthly — with the monthly review feeding back into persona scoring.">

      <!-- START -->
      <rect x="290" y="40" width="300" height="64" rx="32" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <text x="440" y="66" text-anchor="middle" font-family="var(--font-mono)" font-size="14">Scrape Job Postings</text>
      <text x="440" y="88" text-anchor="middle" font-family="var(--font-sans)" font-size="10.5" opacity="0.65">LinkedIn · StepStone · Indeed · Bundesagentur</text>

      <line x1="440" y1="104" x2="440" y2="140" stroke="currentColor" stroke-width="1.5"/>
      <polygon points="440,148 434,136 446,136" fill="currentColor"/>

      <!-- DIAMOND 1 -->
      <polygon points="440,148 590,218 440,288 290,218" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <text x="440" y="214" text-anchor="middle" font-family="var(--font-mono)" font-size="13.5">Auto-reject gates?</text>
      <text x="440" y="230" text-anchor="middle" font-family="var(--font-sans)" font-size="9.5" opacity="0.65">any true → skip</text>

      <text x="440" y="304" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" opacity="0.75">German C1+ · ≥4 yrs · Senior/Lead title</text>
      <text x="440" y="318" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" opacity="0.75">Hands-on SAP · Deep SQL · Licence required</text>

      <line x1="590" y1="218" x2="686" y2="218" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3"/>
      <polygon points="694,218 682,212 682,224" fill="currentColor"/>
      <text x="638" y="210" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" opacity="0.7">any true</text>
      <rect x="694" y="187" width="206" height="62" rx="4" fill="none" stroke="currentColor" stroke-width="1.25" stroke-dasharray="4 3" opacity="0.85"/>
      <text x="797" y="212" text-anchor="middle" font-family="var(--font-mono)" font-size="12" opacity="0.85">Skip —</text>
      <text x="797" y="228" text-anchor="middle" font-family="var(--font-mono)" font-size="12" opacity="0.85">don't generate</text>

      <line x1="440" y1="330" x2="440" y2="366" stroke="currentColor" stroke-width="1.5"/>
      <polygon points="440,374 434,362 446,362" fill="currentColor"/>
      <text x="460" y="352" font-family="var(--font-mono)" font-size="9.5" opacity="0.7">all false</text>

      <!-- Persona Scoring -->
      <rect x="290" y="374" width="300" height="64" rx="4" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <text x="440" y="400" text-anchor="middle" font-family="var(--font-mono)" font-size="14">Persona Scoring</text>
      <text x="440" y="422" text-anchor="middle" font-family="var(--font-sans)" font-size="10.5" opacity="0.65">PMO · Process · Digital Transformation · Ops · Quality</text>

      <line x1="440" y1="438" x2="440" y2="474" stroke="currentColor" stroke-width="1.5"/>
      <polygon points="440,482 434,470 446,470" fill="currentColor"/>

      <!-- DIAMOND 2 -->
      <polygon points="440,482 590,552 440,622 290,552" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <text x="440" y="548" text-anchor="middle" font-family="var(--font-mono)" font-size="13.5">Verdict?</text>
      <text x="440" y="564" text-anchor="middle" font-family="var(--font-sans)" font-size="9.5" opacity="0.65">APPLY · STRETCH · REJECT</text>

      <line x1="590" y1="552" x2="686" y2="552" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3"/>
      <polygon points="694,552 682,546 682,558" fill="currentColor"/>
      <text x="638" y="544" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" opacity="0.7">REJECT</text>
      <rect x="694" y="521" width="206" height="62" rx="4" fill="none" stroke="currentColor" stroke-width="1.25" stroke-dasharray="4 3" opacity="0.85"/>
      <text x="797" y="558" text-anchor="middle" font-family="var(--font-mono)" font-size="12" opacity="0.85">Skip</text>

      <line x1="440" y1="622" x2="440" y2="658" stroke="currentColor" stroke-width="1.5"/>
      <polygon points="440,666 434,654 446,654" fill="currentColor"/>
      <text x="470" y="648" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" opacity="0.7">APPLY / STRETCH</text>

      <!-- Confidence Score -->
      <rect x="290" y="666" width="300" height="64" rx="4" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <text x="440" y="692" text-anchor="middle" font-family="var(--font-mono)" font-size="14">Confidence Score</text>
      <text x="440" y="714" text-anchor="middle" font-family="var(--font-sans)" font-size="10.5" opacity="0.65">Application Confidence Score</text>

      <line x1="440" y1="730" x2="440" y2="766" stroke="currentColor" stroke-width="1.5"/>
      <polygon points="440,774 434,762 446,762" fill="currentColor"/>

      <!-- DIAMOND 3 -->
      <polygon points="440,774 590,844 440,914 290,844" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <text x="440" y="840" text-anchor="middle" font-family="var(--font-mono)" font-size="13.5">Confidence?</text>
      <text x="440" y="856" text-anchor="middle" font-family="var(--font-sans)" font-size="9.5" opacity="0.65">STOP · APPROVE · AUTO</text>

      <line x1="590" y1="844" x2="686" y2="844" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3"/>
      <polygon points="694,844 682,838 682,850" fill="currentColor"/>
      <text x="638" y="836" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" opacity="0.7">STOP</text>
      <rect x="694" y="813" width="206" height="62" rx="4" fill="none" stroke="currentColor" stroke-width="1.25" stroke-dasharray="4 3" opacity="0.85"/>
      <text x="797" y="838" text-anchor="middle" font-family="var(--font-mono)" font-size="12" opacity="0.85">Hold —</text>
      <text x="797" y="854" text-anchor="middle" font-family="var(--font-mono)" font-size="12" opacity="0.85">human decides</text>

      <line x1="440" y1="914" x2="440" y2="950" stroke="currentColor" stroke-width="1.5"/>
      <polygon points="440,958 434,946 446,946" fill="currentColor"/>
      <text x="475" y="942" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" opacity="0.7">APPROVE / AUTO</text>

      <!-- Generate CV + CL (amber) -->
      <rect x="290" y="958" width="300" height="64" rx="4" fill="none" stroke="var(--color-accent)" stroke-width="2"/>
      <text x="440" y="984" text-anchor="middle" font-family="var(--font-mono)" font-size="14">Generate CV + Cover Letter</text>
      <text x="440" y="1006" text-anchor="middle" font-family="var(--font-sans)" font-size="10.5" opacity="0.65">every keyword traces to a real CV bullet</text>

      <line x1="440" y1="1022" x2="440" y2="1058" stroke="currentColor" stroke-width="1.5"/>
      <polygon points="440,1066 434,1054 446,1054" fill="currentColor"/>

      <!-- DIAMOND 4 -->
      <polygon points="440,1066 590,1136 440,1206 290,1136" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <text x="440" y="1132" text-anchor="middle" font-family="var(--font-mono)" font-size="13.5">ATS ≥ 75%?</text>
      <text x="440" y="1148" text-anchor="middle" font-family="var(--font-sans)" font-size="9.5" opacity="0.65">local pre-submission gate</text>

      <line x1="590" y1="1136" x2="686" y2="1136" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3"/>
      <polygon points="694,1136 682,1130 682,1142" fill="currentColor"/>
      <text x="638" y="1128" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" opacity="0.7">&lt; 75%</text>
      <rect x="694" y="1105" width="206" height="62" rx="4" fill="none" stroke="currentColor" stroke-width="1.25" stroke-dasharray="4 3" opacity="0.85"/>
      <text x="797" y="1130" text-anchor="middle" font-family="var(--font-mono)" font-size="12" opacity="0.85">Flagged —</text>
      <text x="797" y="1146" text-anchor="middle" font-family="var(--font-mono)" font-size="12" opacity="0.85">needs review</text>

      <line x1="440" y1="1206" x2="440" y2="1242" stroke="currentColor" stroke-width="1.5"/>
      <polygon points="440,1250 434,1238 446,1238" fill="currentColor"/>
      <text x="472" y="1234" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" opacity="0.7">≥ 75%</text>

      <!-- Human Review (amber) -->
      <rect x="290" y="1250" width="300" height="64" rx="4" fill="none" stroke="var(--color-accent)" stroke-width="2"/>
      <text x="440" y="1276" text-anchor="middle" font-family="var(--font-mono)" font-size="14">Human Review</text>
      <text x="440" y="1298" text-anchor="middle" font-family="var(--font-sans)" font-size="10.5" opacity="0.65">every application, every time</text>

      <line x1="440" y1="1314" x2="440" y2="1350" stroke="currentColor" stroke-width="1.5"/>
      <polygon points="440,1358 434,1346 446,1346" fill="currentColor"/>

      <!-- Send + Outreach -->
      <rect x="290" y="1358" width="300" height="64" rx="4" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <text x="440" y="1384" text-anchor="middle" font-family="var(--font-mono)" font-size="14">Send + Outreach</text>
      <text x="440" y="1406" text-anchor="middle" font-family="var(--font-sans)" font-size="10.5" opacity="0.65">application + referral lever</text>

      <line x1="440" y1="1422" x2="440" y2="1458" stroke="currentColor" stroke-width="1.5"/>
      <polygon points="440,1466 434,1454 446,1454" fill="currentColor"/>

      <!-- Log in Tracker -->
      <rect x="290" y="1466" width="300" height="64" rx="4" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <text x="440" y="1492" text-anchor="middle" font-family="var(--font-mono)" font-size="14">Log in Tracker</text>
      <text x="440" y="1514" text-anchor="middle" font-family="var(--font-sans)" font-size="10.5" opacity="0.65">single source of truth</text>

      <line x1="440" y1="1530" x2="440" y2="1566" stroke="currentColor" stroke-width="1.5"/>
      <polygon points="440,1574 434,1562 446,1562" fill="currentColor"/>

      <!-- Monthly Review -->
      <rect x="290" y="1574" width="300" height="64" rx="4" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <text x="440" y="1600" text-anchor="middle" font-family="var(--font-mono)" font-size="14">Monthly Review</text>
      <text x="440" y="1622" text-anchor="middle" font-family="var(--font-sans)" font-size="10.5" opacity="0.65">feedback loop</text>

      <path d="M 440 1638 L 440 1678 L 930 1678 L 930 406 L 598 406"
            fill="none" stroke="var(--color-accent)" stroke-width="1.5"/>
      <polygon points="590,406 602,400 602,412" fill="var(--color-accent)"/>
      <text x="935" y="1040" font-family="var(--font-mono)" font-size="11" fill="var(--color-accent)" transform="rotate(-90 935 1040)" text-anchor="middle">revise personas</text>

    </svg>
  </div>
  <figcaption>
    The actual pipeline. Amber marks the moments explained below; dashed boxes are dead ends — nothing gets sent from there. Digital version for now — a hand-drawn one replaces it as its own changelog entry.
  </figcaption>
</figure>

<style>
  .cos-diagram {
    margin: 0 0 var(--space-6);
  }
  .wrap {
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: var(--space-3) var(--space-2);
  }
  svg {
    display: block;
    width: 100%;
    max-width: 46rem;
    height: auto;
    margin: 0 auto;
    color: var(--color-ink);
  }
  figcaption {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }
</style>
