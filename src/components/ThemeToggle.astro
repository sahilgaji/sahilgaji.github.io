---
// Manual dark/light override. Defaults to the OS preference (tokens.css
// media query); a click sets an explicit choice on <html data-theme> and
// persists it. The pre-paint script in Base.astro applies a saved choice
// before first render, so there's no flash of the wrong theme.
---

<button id="theme-toggle" type="button" aria-label="Toggle dark and light theme">
  <svg class="icon sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
  </svg>
  <svg class="icon moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />
  </svg>
</button>

<style is:global>
  #theme-toggle {
    background: none;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-ink);
    padding: 0;
  }
  #theme-toggle:hover {
    border-color: var(--color-accent);
  }
  #theme-toggle .icon {
    width: 1rem;
    height: 1rem;
    display: none;
  }

  /* Follow OS preference until the visitor overrides it explicitly. */
  @media (prefers-color-scheme: dark) {
    #theme-toggle .icon.sun {
      display: block;
    }
  }
  @media (prefers-color-scheme: light) {
    #theme-toggle .icon.moon {
      display: block;
    }
  }
  /* Explicit override wins: shows the icon for the mode a click switches TO. */
  html[data-theme="dark"] #theme-toggle .icon.sun {
    display: block;
  }
  html[data-theme="dark"] #theme-toggle .icon.moon {
    display: none;
  }
  html[data-theme="light"] #theme-toggle .icon.sun {
    display: none;
  }
  html[data-theme="light"] #theme-toggle .icon.moon {
    display: block;
  }
</style>

<script>
  const btn = document.getElementById("theme-toggle");

  function isDarkNow(): boolean {
    const explicit = document.documentElement.getAttribute("data-theme");
    if (explicit) return explicit === "dark";
    return window.matchMedia("(prefers-color-scheme: dark)").matches;
  }

  btn?.addEventListener("click", () => {
    const next = isDarkNow() ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    try {
      localStorage.setItem("theme", next);
    } catch {
      // localStorage unavailable (private browsing) — the choice just won't persist.
    }
  });
</script>
