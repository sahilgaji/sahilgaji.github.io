---
// Status indicator, not decoration: the site is now linked from Sahil's CV,
// so a first-time visitor needs to know this is a live, unfinished, actively
// shipping project before they read anything else. The pulsing dot is a
// deliberate, small exception to the site's usual "animate once" rule (Phase
// 5) — justified the same way a recording light is: continuous motion that
// carries real, ongoing status, not decoration. Static (no pulse) under
// prefers-reduced-motion.
interface Props {
  label: string;
  linkLabel: string;
}
const { label, linkLabel } = Astro.props;
---

<a href="/changelog/" class="wip">
  <span class="dot" aria-hidden="true"></span>
  <span class="text">{label}</span>
  <span class="link">{linkLabel} →</span>
</a>

<style>
  .wip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    margin-bottom: var(--space-6);
  }
  .wip:hover {
    border-color: var(--color-accent);
    color: var(--color-ink);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
    animation: wip-pulse 2s ease-in-out infinite;
  }
  .link {
    color: var(--color-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }
  @keyframes wip-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
</style>
