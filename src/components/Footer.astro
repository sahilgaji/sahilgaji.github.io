---
import changelog from "../data/changelog.json";

interface Props {
  lang?: "en" | "de";
}

const { lang = "en" } = Astro.props;
const version = changelog[0].version;
const siteWord = lang === "de" ? "Website" : "site";
const changelogLabel = lang === "de" ? "Changelog" : "changelog";
const setIn = lang === "de" ? "Gesetzt in" : "Set in";
---

<footer>
  <p>
    © 2026 Sahil Gaji · {siteWord} v{version} ·
    <a href="/changelog/">{changelogLabel}</a>
  </p>
  <p>
    <a href="https://www.linkedin.com/in/sahil-gaji/">LinkedIn</a> ·
    <a href="https://github.com/sahilgaji/sahilgaji.github.io">GitHub</a> ·
    <a href="/impressum/">Impressum</a> ·
    <a href="/datenschutz/">Datenschutz</a>
  </p>
  <p class="type-credit">{setIn} Newsreader &amp; Geist Mono</p>
</footer>

<style>
  footer {
    max-width: var(--measure-prose);
    margin: 0 auto;
    padding: var(--space-4) var(--space-3);
    border-top: 1px solid var(--color-line);
  }
  p {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-1);
  }
  .type-credit {
    opacity: 0.6;
    margin-bottom: 0;
  }
</style>
