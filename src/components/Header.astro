---
import ThemeToggle from "./ThemeToggle.astro";
import Nav from "./Nav.astro";

interface Props {
  current?: "work" | "how-i-work" | "notes" | "about";
}
const { current } = Astro.props;
---

<header>
  <a class="wordmark" href="/">Sahil Gaji</a>
  <div class="right">
    <Nav current={current} />
    <ThemeToggle />
  </div>
</header>

<style>
  header {
    max-width: var(--measure-prose);
    margin: 0 auto;
    padding: var(--space-3) var(--space-3) 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .wordmark {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--color-ink);
    text-decoration: none;
  }
  .wordmark:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
  }
</style>
